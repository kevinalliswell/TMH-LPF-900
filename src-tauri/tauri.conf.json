{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TMH-LPF-900",
  "version": "0.2.0",
  "identifier": "cn.edu.ustb.tmh-lpf-900",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TMH-LPF-900 v0.2.0",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/kevinalliswell/TMH-LPF-900-releases/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUxOUM0Njg3RTU4RDkzNDMKUldSRGs0M2xoMGFjVVVMMmNDMStzaGxlaEs2QTFzU3lhb052MkpoSXFhOVVEdmloaG5YbFlxNUMK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis",
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      },
      "webviewInstallMode": {
        "type": "offlineInstaller"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
